---
const {
  size = 'default', // 'hero' | 'default'
  placeholder = 'What do you need help with?',
} = Astro.props;
---

<div class:list={['search-box', size === 'hero' && 'search-box-hero']}>
  <form id="site-search-form" role="search" aria-label="Search Maths Made Clearer" autocomplete="off">
    <label for="site-search-input" class="visually-hidden">Search for a maths topic</label>
    <svg width="18" height="18" viewBox="0 0 17 17" aria-hidden="true" class="search-icon"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M11.2 11.2 15 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <input
      id="site-search-input"
      name="q"
      type="search"
      placeholder={placeholder}
      data-track="search-input"
    />
    <button type="submit" class="btn btn-primary search-submit">Search</button>
  </form>
  {size === 'hero' && (
    <p class="search-examples">
      Try: <button type="button" class="chip" data-example>percentage increase</button>
      <button type="button" class="chip" data-example>nth term</button>
      <button type="button" class="chip" data-example>fractions</button>
      <button type="button" class="chip" data-example>simultaneous equations</button>
    </p>
  )}
  <ul id="site-search-results" class="search-results" hidden></ul>
</div>

<style>
  .search-box { width: 100%; max-width: 640px; position: relative; }
  #site-search-form {
    display: flex;
    align-items: center;
    background: var(--paper-raised);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-md);
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    gap: 0.5rem;
  }
  .search-box-hero #site-search-form {
    box-shadow: var(--shadow-card);
    padding: 0.45rem 0.45rem 0.45rem 1.15rem;
  }
  .search-icon { color: var(--ink-soft); flex-shrink: 0; }
  #site-search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 1rem;
    padding-block: 0.7em;
    min-width: 0;
    color: var(--ink);
  }
  #site-search-input:focus { outline: none; }
  .search-submit { flex-shrink: 0; }

  .search-examples {
    margin-top: 0.9rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .chip {
    font-family: inherit;
    font-size: 0.85rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35em 0.85em;
    cursor: pointer;
    color: var(--ink);
  }
  .chip:hover { border-color: var(--accent); color: var(--accent-dark); }

  .search-results {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    position: absolute;
    top: 100%;
    left: 0; right: 0;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    max-height: 340px;
    overflow-y: auto;
    z-index: 30;
  }
  .search-results li { border-bottom: 1px solid var(--line); }
  .search-results li:last-child { border-bottom: none; }
  .search-results a {
    display: block;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: var(--ink);
  }
  .search-results a:hover { background: var(--paper); }
  .search-results .result-type { font-size: 0.78rem; color: var(--accent-dark); font-weight: 600; }
  .search-results .result-empty { padding: 0.9rem 1rem; color: var(--ink-soft); font-size: 0.9rem; }
</style>

<script>
  // Client-side search against /search-index.json, generated at build
  // time from src/data/resources.js (see src/pages/search-index.json.js).
  let indexPromise;
  function loadIndex() {
    if (!indexPromise) {
      indexPromise = fetch('/search-index.json').then((r) => r.json());
    }
    return indexPromise;
  }

  function score(entry, query) {
    const q = query.toLowerCase().trim();
    if (!q) return 0;
    let s = 0;
    if (entry.title.toLowerCase() === q) s += 100;
    if (entry.title.toLowerCase().includes(q)) s += 50;
    if (entry.keywords.some((k) => k === q)) s += 60;
    if (entry.keywords.some((k) => k.includes(q))) s += 30;
    if (entry.topic.toLowerCase().includes(q)) s += 10;
    // partial word match across keywords
    const words = q.split(/\s+/).filter(Boolean);
    words.forEach((w) => {
      if (entry.title.toLowerCase().includes(w)) s += 8;
      if (entry.keywords.some((k) => k.includes(w))) s += 6;
    });
    return s;
  }

  async function runSearch(query) {
    const data = await loadIndex();
    if (!query.trim()) return [];
    return data
      .map((entry) => ({ entry, s: score(entry, query) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 8)
      .map((r) => r.entry);
  }

  function renderResults(container, results, query) {
    container.innerHTML = '';
    if (!query.trim()) {
      container.hidden = true;
      return;
    }
    if (results.length === 0) {
      container.hidden = false;
      container.innerHTML = `<li class="result-empty">No matches for “${query}” yet — try a shorter word, or use Request Help to ask for it.</li>`;
      return;
    }
    container.hidden = false;
    results.forEach((r) => {
      const li = document.createElement('li');
      li.innerHTML = `<a href="${r.url}" data-track="search-result-click" data-resource="${r.slug}"><span class="result-type">${r.typeLabel}</span><br>${r.title}</a>`;
      container.appendChild(li);
    });
  }

  document.querySelectorAll('.search-box').forEach((box) => {
    const form = box.querySelector('#site-search-form') || box.querySelector('form');
    const input = box.querySelector('input[type="search"]');
    const results = box.querySelector('.search-results');
    if (!form || !input || !results) return;

    let debounceTimer;
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        const q = input.value;
        const r = await runSearch(q);
        renderResults(results, r, q);
      }, 120);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (q) {
        window.location.href = `/search/?q=${encodeURIComponent(q)}`;
      }
    });

    box.querySelectorAll('[data-example]').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.location.href = `/search/?q=${encodeURIComponent(btn.textContent.trim())}`;
      });
    });

    document.addEventListener('click', (e) => {
      if (!box.contains(e.target)) results.hidden = true;
    });
  });
</script>
